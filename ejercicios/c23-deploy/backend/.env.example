# Copiá este archivo a .env para usarlo con Docker Compose.
NODE_ENV=development
# En Render, la plataforma inyecta PORT.
PORT=3000
# En Render, usá la URL del Static Site sin barra final.
FRONTEND_URL=http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=libreria_db
POSTGRES_PORT=5432
# En Render, usá la conexión directa de Neon con SSL.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}

CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1

# En Render, generá el valor desde el panel de variables.
JWT_SECRET=cambiame_por_una_cadena_larga_y_aleatoria
